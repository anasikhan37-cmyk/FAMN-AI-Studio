<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090d18">
<title>FAMN AI STUDIO</title>
<style>
:root{--bg:#090d18;--panel:#111827;--panel2:#151f32;--line:#27344b;--text:#f4f7ff;--muted:#9aa8bf;--purple:#8b5cf6;--cyan:#38bdf8;--green:#34d399;--yellow:#fbbf24}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 80% -10%,#27204a 0,transparent 35%),var(--bg);color:var(--text);font:15px/1.5 Inter,system-ui,Segoe UI,Arial,sans-serif}
button,input,textarea{font:inherit}button{cursor:pointer;border:0}.hidden{display:none!important}.wrap{max-width:1180px;margin:auto;padding:24px}.brand{display:flex;align-items:center;gap:11px;font-weight:800;letter-spacing:.06em}.logo{width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,var(--purple),var(--cyan));display:grid;place-items:center;font-weight:900;color:white;box-shadow:0 8px 28px #8b5cf655}
.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:34px}.tag{color:#c4b5fd;border:1px solid #6046a5;background:#20183b;padding:5px 10px;border-radius:999px;font-size:12px}
h1{font-size:clamp(32px,5vw,54px);line-height:1.08;margin:18px 0}h2{font-size:25px;margin:0 0 8px}h3{margin:0 0 7px}.muted{color:var(--muted)}.small{font-size:12px;color:var(--muted)}
.btn{padding:11px 16px;border-radius:11px;font-weight:700;color:white;background:linear-gradient(110deg,#7c3aed,#2563eb);box-shadow:0 8px 22px #4f46e533}.btn.secondary{background:#202b40;border:1px solid var(--line);box-shadow:none}.btn.ghost{background:transparent;border:1px solid var(--line);box-shadow:none}.btn:disabled{opacity:.45;cursor:not-allowed}
.card{background:linear-gradient(160deg,#151f32,#101726);border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:0 18px 55px #0002}.auth{max-width:490px;margin:8vh auto}.auth p{margin-top:0}.field{display:grid;gap:6px;margin:13px 0}.field label{font-size:13px;color:#c4cee0}.field input,.field textarea{width:100%;background:#0b1220;border:1px solid var(--line);color:white;border-radius:10px;padding:12px;outline:none}.field input:focus,.field textarea:focus{border-color:var(--purple)}.row{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.between{display:flex;justify-content:space-between;align-items:center;gap:12px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.stat{font-size:27px;font-weight:800}.statlabel{color:var(--muted);font-size:13px}.layout{display:grid;grid-template-columns:235px 1fr;gap:20px}.sidebar{height:max-content;position:sticky;top:18px}.nav{display:grid;gap:7px;margin-top:18px}.nav button{background:transparent;color:#b8c4d9;text-align:left;padding:11px;border-radius:10px}.nav button.active,.nav button:hover{background:#282044;color:white}.content{min-width:0}.hero{padding:28px;background:linear-gradient(120deg,#25184a,#102b45);border:1px solid #493875;border-radius:20px;margin-bottom:17px}.hero p{max-width:600px;color:#d3d8ec}.pill{display:inline-flex;padding:5px 9px;border:1px solid var(--line);border-radius:999px;color:#cbd5e1;font-size:12px}.feature{min-height:130px}.feature .emoji{font-size:25px;margin-bottom:8px}.notice{padding:12px 14px;border-radius:12px;background:#342b17;border:1px solid #6b5526;color:#f6dfaa;font-size:13px;margin:14px 0}.success{background:#0e3028;border-color:#1c6b55;color:#b7f7df}.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.plan{border:1px solid var(--line);border-radius:14px;padding:16px;background:#0d1524}.price{font-size:25px;font-weight:800;margin:8px 0}.table{width:100%;border-collapse:collapse}.table td,.table th{text-align:left;padding:11px;border-bottom:1px solid var(--line);font-size:13px}.table th{color:var(--muted)}.empty{padding:25px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:12px}.right{margin-left:auto}
@media(max-width:800px){.layout{grid-template-columns:1fr}.sidebar{position:static}.nav{grid-template-columns:repeat(3,1fr)}.grid,.plans{grid-template-columns:1fr 1fr}.wrap{padding:15px}}
@media(max-width:520px){.grid,.plans{grid-template-columns:1fr}.top{align-items:flex-start}.top .tag{display:none}.nav{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <div class="brand"><div class="logo">F</div><span>FAMN <span style="color:#a78bfa">AI STUDIO</span></span></div>
    <span class="tag">VOICE-POWERED CREATIVE STUDIO</span>
  </header>

  <section id="authView" class="auth card">
    <div class="brand" style="margin-bottom:20px"><div class="logo">F</div><span>Welcome to FAMN</span></div>
    <h2 id="authTitle">Create your account</h2>
    <p class="muted" id="authSub">Register to get your starter credits and open your studio.</p>
    <div id="nameField" class="field"><label>Your name</label><input id="name" placeholder="Enter your name"></div>
    <div class="field"><label>Email</label><input id="email" type="email" placeholder="you@example.com"></div>
    <div class="field"><label>Password</label><input id="password" type="password" placeholder="At least 6 characters"></div>
    <button class="btn" id="authSubmit" style="width:100%">Create account</button>
    <p class="small" id="authMessage" role="status"></p>
    <div class="between" style="margin-top:16px"><span class="small" id="switchText">Already registered?</span><button class="btn ghost" id="switchAuth">Log in</button></div>
    <div class="notice">Prototype only: this preview uses browser storage, not secure real accounts. Do not enter a real password or payment details.</div>
    <button class="btn secondary" id="ownerPreview" style="width:100%">Preview owner dashboard (demo)</button>
  </section>

  <section id="appView" class="hidden">
    <div class="layout">
      <aside class="sidebar card">
        <div class="between"><div><div class="small">SIGNED IN AS</div><strong id="sideName">Creator</strong></div><span class="pill" id="rolePill">Creator</span></div>
        <div class="nav">
          <button class="active" data-page="home">⌂ &nbsp; Overview</button>
          <button data-page="create">🎙 &nbsp; Create video</button>
          <button data-page="projects">▣ &nbsp; My projects</button>
          <button data-page="wallet">◈ &nbsp; Credits & recharge</button>
          <button data-page="admin" id="adminNav" class="hidden">⚙ &nbsp; Owner panel</button>
        </div>
        <button class="btn ghost" id="logout" style="width:100%;margin-top:18px">Log out</button>
      </aside>
      <main class="content">
        <div class="between" style="margin-bottom:15px"><div><div class="small">FAMN AI STUDIO / <span id="pageCrumb">OVERVIEW</span></div><h2 id="pageTitle">Your creative dashboard</h2></div><span class="pill">✦ <b id="creditCount">100</b>&nbsp; credits</span></div>

        <section id="page-home">
          <div class="hero"><span class="pill">YOUR IDEAS, YOUR STUDIO</span><h1>Make something<br><span style="color:#c4b5fd">extraordinary.</span></h1><p>Start with a story, a prompt, or your voice. Plan scenes and manage your video projects from one place.</p><button class="btn" data-goto="create">＋ Start a project</button></div>
          <div class="grid">
            <div class="card"><div class="stat" id="homeCredits">100</div><div class="statlabel">Available credits</div></div>
            <div class="card"><div class="stat" id="projectCount">0</div><div class="statlabel">My projects</div></div>
            <div class="card"><div class="stat">Starter</div><div class="statlabel">Current plan</div></div>
          </div>
          <h3 style="margin:23px 0 12px">Explore your studio</h3>
          <div class="grid">
            <div class="card feature"><div class="emoji">🎙️</div><h3>Voice to idea</h3><div class="small">Speak your video idea and turn it into a prompt.</div></div>
            <div class="card feature"><div class="emoji">📝</div><h3>Story to video</h3><div class="small">Plan a story and its scenes.</div></div>
            <div class="card feature"><div class="emoji">🎬</div><h3>Video projects</h3><div class="small">Keep your work organised.</div></div>
          </div>
          <div class="notice">This is the first visual prototype. Real AI video generation, secure sign-in, cloud projects and live payments are not connected yet.</div>
        </section>

        <section id="page-create" class="hidden">
          <div class="card">
            <h3>Create a video project</h3><p class="muted">Describe what you want to make. You can type or use voice input if your browser supports it.</p>
            <div class="field"><label>Video idea / prompt</label><textarea id="prompt" rows="5" placeholder="Example: Create a Hindi animated adventure about a clever young inventor..."></textarea></div>
            <div class="row"><button class="btn secondary" id="voiceBtn">🎙 Start voice input</button><span class="small" id="voiceStatus">Voice input availability depends on your browser.</span></div>
            <div class="field"><label>Video format</label><select id="format" style="background:#0b1220;color:white;padding:12px;border:1px solid var(--line);border-radius:10px"><option>16:9 YouTube video</option><option>9:16 Shorts / Reels</option><option>1:1 Square video</option></select></div>
            <button class="btn" id="createProject">Save demo project</button>
            <div class="notice">This button saves a project idea only. It does not generate a video or spend credits in this prototype.</div>
          </div>
        </section>

        <section id="page-projects" class="hidden"><div class="card"><div class="between"><h3>My projects</h3><span class="pill">Saved in this browser preview</span></div><div id="projectList" class="empty">No projects yet. Start your first idea.</div></div></section>

        <section id="page-wallet" class="hidden">
          <div class="card"><div class="between"><div><div class="small">AVAILABLE BALANCE</div><div class="stat"><span id="walletCredits">100</span> credits</div></div><span class="pill">Starter wallet</span></div></div>
          <h3 style="margin:22px 0 12px">Choose a recharge pack (sample prices)</h3>
          <div class="plans">
            <div class="plan"><span class="pill">Starter</span><div class="price">₹49</div><p class="muted small">500 sample credits</p><button class="btn secondary recharge" data-pack="Starter" data-amount="49" data-credits="500">Request recharge</button></div>
            <div class="plan"><span class="pill">Creator</span><div class="price">₹99</div><p class="muted small">1,200 sample credits</p><button class="btn recharge" data-pack="Creator" data-amount="99" data-credits="1200">Request recharge</button></div>
            <div class="plan"><span class="pill">Pro</span><div class="price">₹199</div><p class="muted small">3,000 sample credits</p><button class="btn secondary recharge" data-pack="Pro" data-amount="199" data-credits="3000">Request recharge</button></div>
          </div>
          <div id="paymentForm" class="card hidden" style="margin-top:15px"><h3>Recharge request</h3><p class="muted small" id="paymentSummary"></p><div class="field"><label>UTR / transaction reference (demo only)</label><input id="utr" placeholder="Enter reference after payment"></div><button class="btn" id="submitPayment">Submit request</button><p class="small" id="paymentStatus"></p><div class="notice">No real payment is collected here. A real UPI QR, merchant account and verified server-side payment process must be added before launch.</div></div>
          <h3 style="margin:22px 0 10px">My recharge requests</h3><div id="myPayments" class="empty">No requests yet.</div>
        </section>

        <section id="page-admin" class="hidden">
          <div class="notice">Owner preview only. This demo panel is not protected by real admin security.</div>
          <div class="grid">
            <div class="card"><div class="stat" id="adminUsers">1</div><div class="statlabel">Demo accounts on this browser</div></div>
            <div class="card"><div class="stat" id="adminRequests">0</div><div class="statlabel">Pending recharge requests</div></div>
            <div class="card"><div class="stat">₹0</div><div class="statlabel">Verified revenue (demo)</div></div>
          </div>
          <div class="card" style="margin-top:15px"><h3>Recharge approval queue</h3><div id="adminPayments" class="empty">No pending requests.</div></div>
        </section>
      </main>
    </div>
  </section>
  <footer class="small" style="text-align:center;padding:28px 0">© FAMN AI STUDIO · Prototype v0.1 · Built for the first product preview</footer>
</div>
<script>
const $=id=>document.getElementById(id);
let mode="register", currentUser=null, selectedPack=null;
const read=(k,d)=>{try{return JSON.parse(localStorage.getItem(k))??d}catch{return d}};
const write=(k,v)=>localStorage.setItem(k,JSON.stringify(v));
function users(){return read("famn_demo_users",[])}
function payments(){return read("famn_demo_payments",[])}
function projects(){return read("famn_demo_projects",[])}
function setMode(m){mode=m;$("authTitle").textContent=m==="register"?"Create your account":"Welcome back";$("authSub").textContent=m==="register"?"Register to open your studio.":"Log in to continue to your studio.";$("nameField").classList.toggle("hidden",m!=="register");$("authSubmit").textContent=m==="register"?"Create account":"Log in";$("switchText").textContent=m==="register"?"Already registered?":"New to FAMN?";$("switchAuth").textContent=m==="register"?"Log in":"Create account";$("authMessage").textContent=""}
$("switchAuth").onclick=()=>setMode(mode==="register"?"login":"register");
function showApp(user,owner=false){currentUser=user;$("authView").classList.add("hidden");$("appView").classList.remove("hidden");$("sideName").textContent=owner?"Owner preview":user.name;$("rolePill").textContent=owner?"Owner":"Creator";$("adminNav").classList.toggle("hidden",!owner);refresh();go(owner?"admin":"home")}
$("authSubmit").onclick=()=>{
 const email=$("email").value.trim().toLowerCase(), pass=$("password").value;
 if(!email||pass.length<6){$("authMessage").textContent="Please enter a valid email and a password of at least 6 characters.";return}
 if(mode==="register"){if(!$("name").value.trim()){ $("authMessage").textContent="Please enter your name.";return}if(users().some(u=>u.email===email)){$("authMessage").textContent="This demo email is already registered.";return}
 const u={name:$("name").value.trim(),email,credits:100};write("famn_demo_users",[...users(),u]);showApp(u)
 }else{const u=users().find(u=>u.email===email);if(!u){$("authMessage").textContent="No demo account found. Please register first.";return}showApp(u)}
};
$("ownerPreview").onclick=()=>showApp({name:"Owner",email:"owner-demo"},true);
function refresh(){if(!currentUser)return;let u=users().find(x=>x.email===currentUser.email)||currentUser;let c=u.credits??100;$("creditCount").textContent=c;$("homeCredits").textContent=c;$("walletCredits").textContent=c;$("projectCount").textContent=projects().filter(p=>p.email===currentUser.email).length;renderProjects();renderMyPayments();renderAdmin()}
function go(page){document.querySelectorAll("[id^=page-]").forEach(x=>x.classList.add("hidden"));$("page-"+page).classList.remove("hidden");document.querySelectorAll(".nav button").forEach(b=>b.classList.toggle("active",b.dataset.page===page));$("pageTitle").textContent=({home:"Your creative dashboard",create:"Create a video project",projects:"My projects",wallet:"Credits & recharge",admin:"Owner dashboard"})[page];$("pageCrumb").textContent=page.toUpperCase()}
document.querySelectorAll("[data-page]").forEach(b=>b.onclick=()=>go(b.dataset.page));document.querySelectorAll("[data-goto]").forEach(b=>b.onclick=()=>go(b.dataset.goto));
$("logout").onclick=()=>{currentUser=null;$("appView").classList.add("hidden");$("authView").classList.remove("hidden");setMode("login")};
$("createProject").onclick=()=>{let prompt=$("prompt").value.trim();if(!prompt){alert("Please enter or speak your video idea first.");return}let list=projects();list.unshift({id:Date.now(),email:currentUser.email,title:prompt.slice(0,70),format:$("format").value,status:"Idea saved · demo only"});write("famn_demo_projects",list);$("prompt").value="";refresh();go("projects")};
$("voiceBtn").onclick=()=>{const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){$("voiceStatus").textContent="Voice input is not supported in this browser. Try Chrome.";return}const rec=new SR();rec.lang="hi-IN";rec.interimResults=false;rec.onstart=()=>$("voiceStatus").textContent="Listening… speak now";rec.onresult=e=>$("prompt").value+=($("prompt").value?" ":"")+e.results[0][0].transcript;rec.onerror=()=>$("voiceStatus").textContent="Voice input could not start. Check microphone permission.";rec.onend=()=>$("voiceStatus").textContent="Voice input finished.";rec.start()};
document.querySelectorAll(".recharge").forEach(b=>b.onclick=()=>{selectedPack={name:b.dataset.pack,amount:b.dataset.amount,credits:b.dataset.credits};$("paymentSummary").textContent=`${selectedPack.name} pack · ₹${selectedPack.amount} · ${selectedPack.credits} sample credits`; $("paymentForm").classList.remove("hidden");$("paymentStatus").textContent="";$("utr").value=""});
$("submitPayment").onclick=()=>{const utr=$("utr").value.trim();if(!utr){$("paymentStatus").textContent="Enter a demo reference to create a sample request.";return}let ps=payments();ps.unshift({id:Date.now(),email:currentUser.email,pack:selectedPack.name,amount:selectedPack.amount,credits:selectedPack.credits,utr,status:"Pending"});write("famn_demo_payments",ps);$("paymentStatus").textContent="Demo request saved. No payment was verified.";refresh()};
function renderProjects(){let ps=projects().filter(p=>p.email===currentUser.email);$("projectList").innerHTML=ps.length?ps.map(p=>`<div style="padding:13px;border-bottom:1px solid var(--line)"><b>${esc(p.title)}</b><div class="small">${esc(p.format)} · ${esc(p.status)}</div></div>`).join(""):'<div class="empty">No projects yet. Start your first idea.</div>'}
function renderMyPayments(){let ps=payments().filter(p=>p.email===currentUser.email);$("myPayments").innerHTML=ps.length?ps.map(p=>`<div style="padding:12px;border-bottom:1px solid var(--line)"><b>₹${p.amount} · ${esc(p.pack)}</b><div class="small">${esc(p.utr)} · ${p.status}</div></div>`).join(""):'<div class="empty">No requests yet.</div>'}
function renderAdmin(){let ps=payments();$("adminRequests").textContent=ps.filter(p=>p.status==="Pending").length;$("adminUsers").textContent=users().length;$("adminPayments").innerHTML=ps.length?ps.map(p=>`<div class="between" style="padding:12px;border-bottom:1px solid var(--line);gap:10px"><div><b>${esc(p.email)}</b><div class="small">₹${p.amount} · ${p.credits} credits · UTR: ${esc(p.utr)} · ${p.status}</div></div>${p.status==="Pending"?`<button class="btn" onclick="approve(${p.id})">Approve demo</button>`:"<span class='pill'>"+p.status+"</span>"}</div>`).join(""):'<div class="empty">No pending requests.</div>'}
function approve(id){let ps=payments(),p=ps.find(x=>x.id===id);if(!p||p.status!=="Pending")return;p.status="Approved (demo)";write("famn_demo_payments",ps);let us=users(),u=us.find(x=>x.email===p.email);if(u){u.credits=(u.credits||0)+Number(p.credits);write("famn_demo_users",us)}refresh()}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
setMode("register");
</script>
</body></html>
